NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://news:news@localhost:5434/karnataka_news
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=14
PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=8388608

# Reverse proxy hops to trust. Cloudflare alone = 1; Cloudflare + nginx = 2.
# Keep this accurate so rate limiting sees the real client IP (X-Forwarded-For).
TRUST_PROXY=1
# Comma-separated browser origins allowed to call the API. Required in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Requests per 15 minutes per IP.
RATE_LIMIT_API=1200
RATE_LIMIT_AUTH=80
RATE_LIMIT_WRITE=300
RATE_LIMIT_COMMENT=8
# Only honored when NODE_ENV=development; returns reset tokens in API responses.
ALLOW_DEV_RESET_TOKENS=true

# Production seed (NODE_ENV=production) creates only taxonomy plus this admin.
# SEED_ADMIN_PASSWORD must be at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Set SEED_DEMO=true only for staging to seed demo articles and known-password accounts.
SEED_DEMO=false
