NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://news:news@localhost:5434/karnataka_news
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=14
PUBLIC_BASE_URL=https://tajasuddinews.in
UPLOAD_MAX_BYTES=8388608

# Reverse proxy hops to trust. Cloudflare alone = 1; Cloudflare + nginx = 2.
# Keep this accurate so rate limiting sees the real client IP (X-Forwarded-For).
TRUST_PROXY=1
# Comma-separated browser origins allowed to call the API. Required in production.
CORS_ORIGINS=https://tajasuddinews.in,https://www.tajasuddinews.in
# Requests per 15 minutes per IP.
RATE_LIMIT_API=1200
RATE_LIMIT_AUTH=80
RATE_LIMIT_WRITE=300
RATE_LIMIT_COMMENT=8
# Only honored when NODE_ENV=development; returns reset tokens in API responses.
ALLOW_DEV_RESET_TOKENS=true

# Production seed (NODE_ENV=production) creates only taxonomy plus this admin.
# SEED_ADMIN_PASSWORD must be at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Set SEED_DEMO=true only for staging to seed demo articles and known-password accounts.
SEED_DEMO=false

# PostgreSQL connection pool max connections (set 6-8 on small VPS instances)
DB_POOL_MAX=12

# Image storage: 'pg' (default for local dev) or 'r2' (Cloudflare R2 offload)
IMAGE_STORAGE=pg
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom public domain connected to the R2 bucket, e.g. https://media.tajasuddinews.in
R2_PUBLIC_BASE_URL=
# Optional frontend Vite build variable matching R2_PUBLIC_BASE_URL (e.g. VITE_MEDIA_BASE_URL=https://media.tajasuddinews.in)
# VITE_MEDIA_BASE_URL=https://media.tajasuddinews.in

# Cloudflare Zone Cache Purge API (optional; enables automatic edge purge on publish/edit/admin updates)
CF_ZONE_ID=
CF_API_TOKEN=
# 'urls' (exact URL purge, Cloudflare Free plan) or 'everything'
CF_CACHE_PURGE_MODE=urls

# Shared secret authenticating batched analytics flushes from the Cloudflare Edge Worker
INTERNAL_FLUSH_SECRET=

